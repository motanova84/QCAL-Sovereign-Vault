# QCAL Sovereign Vault — Variables de Entorno
# =============================================

# Clave privada del desplegador (NUNCA compartir)
PRIVATE_KEY=0x_tu_clave_privada_aqui

# Dirección pública del Secure Enclave firmante
ENCLAVE_SIGNER_ADDRESS=0x_direccion_publica_del_secure_enclave

# RPC Endpoints
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY
BASE_SEPOLIA_URL=https://sepolia.base.org

# Exploradores (Verificación de Contratos)
ETHERSCAN_API_KEY=TU_ETHERSCAN_KEY
BASESCAN_API_KEY=TU_BASESCAN_KEY

# Reporte de Gas
REPORT_GAS=true
